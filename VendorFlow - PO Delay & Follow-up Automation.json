    {
      "parameters": {
        "jsCode": "\nconst ESCALATE_AFTER_DAYS = 3;\n\nconst today = $today.startOf('day');\nconst todayStr = today.toFormat('yyyy-MM-dd');\n\n// Convert Google Sheets date into a valid date\nfunction parseDate(value) {\n  if (!value) return null;\n\n  const s = String(value).trim();\n\n  let date = DateTime.fromISO(s);\n\n  if (date.isValid) return date.startOf('day');\n\n  const formats = [\n    'yyyy-MM-dd',\n    'dd/MM/yyyy',\n    'd/M/yyyy',\n    'MMM d, yyyy',\n    'MMMM d, yyyy',\n    'd MMM yyyy'\n  ];\n\n  for (const format of formats) {\n    date = DateTime.fromFormat(s, format);\n\n    if (date.isValid) {\n      return date.startOf('day');\n    }\n  }\n\n  return null;\n}\n\nconst results = [];\nconst orders = $input.all();\n\nfor (let i = 0; i < orders.length; i++) {\n  const r = orders[i].json;\n\n  const status = String(r['Status'] || '')\n    .trim()\n    .toLowerCase();\n\n  // 1. Process only pending orders\n  if (status !== 'pending') continue;\n\n  // 2. Calculate overdue days\n  const due = parseDate(r['Delivery Date']);\n\n  if (!due) continue;\n\n  const daysOverdue = Math.floor(\n    today.diff(due, 'days').days\n  );\n\n  if (daysOverdue < 1) continue;\n\n  // 3. Read existing follow-up information\n  const reminderCount = Number(r['Reminder Count'] || 0);\n\n  const lastReminderDate = String(\n    r['Last Reminder Date'] || ''\n  ).trim();\n\n  const escalated = String(\n    r['Escalated'] || ''\n  ).trim();\n\n  const escalatedDate = String(\n    r['Escalated Date'] || ''\n  ).trim();\n\n  const alreadyEscalated =\n    ['yes', 'true', '1'].includes(escalated.toLowerCase());\n\n  // 4. Decide action\n  let action = 'skip';\n\n  if (daysOverdue >= ESCALATE_AFTER_DAYS) {\n\n    if (!alreadyEscalated) {\n      action = 'escalate';\n    }\n\n  } else if (\n    reminderCount === 0 &&\n    !lastReminderDate\n  ) {\n\n    action = 'reminder';\n\n  }\n\n  if (action === 'skip') continue;\n\n  // Avoid sending reminders without an email\n  const supplierEmail = String(\n    r['Supplier Email'] || ''\n  ).trim();\n\n  if (action === 'reminder' && !supplierEmail) {\n    continue;\n  }\n\n  // 5. Prepare output for next nodes\n  results.push({\n    json: {\n      rowNumber: r['row_number'],\n      poId: r['PO ID'],\n      material: r['Material'],\n      supplier: r['Supplier'],\n      supplierEmail: supplierEmail,\n\n      deliveryDate: due.toFormat('yyyy-MM-dd'),\n      daysOverdue: daysOverdue,\n\n      action: action,\n\n      followUpStatus:\n        action === 'escalate'\n          ? 'Escalated to Manager'\n          : 'Reminder Sent',\n\n      newReminderCount:\n        action === 'reminder'\n          ? reminderCount + 1\n          : reminderCount,\n\n      newLastReminderDate:\n        action === 'reminder'\n          ? todayStr\n          : lastReminderDate,\n\n      newEscalated:\n        action === 'escalate'\n          ? 'Yes'\n          : escalated,\n\n      newEscalatedDate:\n        action === 'escalate'\n          ? todayStr\n          : escalatedDate,\n\n      sentTo:\n        action === 'escalate'\n          ? 'Manager'\n          : supplierEmail,\n\n      today: todayStr\n    },\n    pairedItem: { item: i }\n  });\n}\n\nreturn results;\n"
      },
